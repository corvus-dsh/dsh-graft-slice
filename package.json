{
  "name": "@corvus-dsh/dsh-graft-slice",
  "version": "0.9.1-beta.1",
  "private": false,
  "description": "星火 OS 切片层 (graft-slice): physical handoff for long sessions: slice a closed log at its last turn/end into a zero-inheritance, cold-resumable session. No fork, no lossy compaction, crash-safe transaction journal. Can carry memory context into the new session.",
  "type": "module",
  "main": "index.js",
  "types": "src/index.ts",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./manifest": "./manifest.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "manifest.json",
    "cordis.patch.yml",
    "src/index.ts",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "ANALYSIS-BRIEF.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check index.js",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "publish": "node scripts/publish.mjs",
    "verify": "node scripts/verify-bundle.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "migration",
    "log-slice"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvus-dsh/dsh-graft-slice.git"
  },
  "homepage": "https://github.com/corvus-dsh/dsh-graft-slice#readme",
  "bugs": {
    "url": "https://github.com/corvus-dsh/dsh-graft-slice/issues"
  }
}
